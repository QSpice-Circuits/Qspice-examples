CC_MIN} , {P_VCC_MAX},{P_IQ_VCC_MAX} )}\nR_QCC VCC COM 1E12\nG_QDD VDD VSS VALUE {TABLE(V(VDD,VSS) , 0,0 , 0.1,1U , 1,1U , 0.8*{P_VDD_MIN},{P_IQ_VDD})}\nR_QDD VDD VSS 1E12\nG_VB_LEAK VB COM VALUE {TABLE(V(VB,COM) , 0,0 , {P_V_LEAK},{P_I_LEAK})}\nR_VB_LEAK VB COM 1E12\n.ENDS IR2112_CC_EMULATOR\n.SUBCKT IR2112_CL_DIO C A PARAMS: P_V_BV=5 P_I_BV=1\nG_CL_DIO C A VALUE {TABLE(V(C,A) , 0,0 , {P_V_BV}*1.01,0 , {P_V_BV}*1.02,{P_I_BV} , 10*{P_V_BV}, 100*{P_I_BV} )}\nC_CL_DIO C A 10F\nR_CL_DIO C A 1E12\n.ENDS IR2112_CL_DIO\n.SUBCKT IR2112_ESD_DIO A C PARAMS: P_V_BV=5 P_I_BV=1\nG_ESD_DIO A C VALUE {TABLE(V(A,C) , 0,0 , {P_V_BV}*1.01,0 , {P_V_BV}*1.02,{P_I_BV} , 10*{P_V_BV}, 100*{P_I_BV} )}\nC_ESD_DIO A C 10F\nR_ESD_DIO A C 1E12\n.ENDS IR2112_ESD_DIO\n.SUBCKT IR2112_RC_DELAY_10 IN OUT PARAMS: P_C_DELAY = 60E-9 P_TH_TPD = 0.5\nX_D1 IN D1 IR2112_RC_DELAY_5 PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\nX_D2 D1 OUT IR2112_RC_DELAY_5 PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\n.ENDS IR2112_RC_DELAY_10\n.SUBCKT IR2112_RC_DELAY_5 IN OUT PARAMS: P_C_DELAY = 60E-9 P_TH_TPD = 0.5\nX_D1 IN D1 IR2112_RC_DELAY_BASE PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\nX_D2 D1 D2 IR2112_RC_DELAY_BASE PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\nX_D3 D2 D3 IR2112_RC_DELAY_BASE PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\nX_D4 D3 D4 IR2112_RC_DELAY_BASE PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\nX_D5 D4 OUT IR2112_RC_DELAY_BASE PARAMS: P_C_DELAY = {P_C_DELAY} P_TH_TPD = {P_TH_TPD}\n.ENDS IR2112_RC_DELAY_5\n.SUBCKT IR2112_RC_DELAY_BASE IN OUT PARAMS: P_C_DELAY = 60E-9 P_TH_TPD = 0.5\nR_DELAY IN IN_DEL 1\nC_DELAY IN_DEL 0 {P_C_DELAY}\nE_DELAY OUT 0 VALUE={IF( V(IN_DEL) > {P_TH_TPD} , 1.0,0.0 )}\n.ENDS IR2112_RC_DELAY_BASE\n.SUBCKT IR2112_ADV_FILTER IN OUT PARAMS: P_C_DELAY = 60E-9 P_TH_TPD = 0.5\nR_RISE IN IN_DEL 1\nC_RISE IN_DEL 0 {P_C_DELAY}\nX_CMP IN_DEL OUT 0 IR2112_STP_IDEAL PARAMS: P_TH_UP=0.999 P_TH_DW=0.001\n.ENDS IR2112_ADV_FILTER\n.SUBCKT IR2112_STP_IDEAL IN OUT GND PARAMS: P_TH_UP=0.9 P_TH_DW=0.1\nE_OUTP OUTP 0 VALUE={IF( V(IN,GND)>={P_TH_UP} | V(OUTN)<0.5 , 1,0 )}\nE_OUTN OUTN 0 VALUE={IF( V(IN,GND)<={P_TH_DW} | V(OUTP)<0.5 , 1,0 )}\nE_OUT OUT 0 VALUE={V(OUTP)}\n.ENDS IR2112_STP_IDEAL\n.SUBCKT IR2112_STN_IDEAL IN OUT GND PARAMS: P_TH_UP=0.9 P_TH_DW=0.1\nE_OUTP OUTP 0 VALUE={IF( V(IN,GND)>={P_TH_UP} | V(OUTN)<0.5 , 1,0 )}\nE_OUTN OUTN 0 VALUE={IF( V(IN,GND)<={P_TH_DW} | V(OUTP)<0.5 , 1,0 )}\nE_OUT OUT 0 VALUE={V(OUTN)}\n.ENDS IR2112_STN_IDEAL\n.SUBCKT IR2112_STP_IDEAL_SUP IN OUT GND SUP PARAMS: P_TH_UP=0.9 P_TH_DW=0.1\nE_TH_UP TH_UP 0 VALUE={TABLE(V(SUP,GND) , 3,2.1 , 20,13)}\nE_TH_DW TH_DW 0 VALUE={TABLE(V(SUP,GND) , 3,1.4 , 20,7)}\nE_OUTP OUTP 0 VALUE={IF( V(IN,GND)>=V(TH_UP) | V(OUTN)<0.5 , 1,0 )}\nE_OUTN OUTN 0 VALUE={IF( V(IN,GND)<=V(TH_DW) | V(OUTP)<0.5 , 1,0 )}\nE_OUT OUT 0 VALUE={V(OUTP)}\n.ENDS IR2112_STP_IDEAL_SUP\n.SUBCKT IR2112_LATCH_SIMPLE S NR Q\nE_PLS SET_PLS 0 VALUE {IF( (V(S) > 0.5 | V(Q) > 0.5), 1.0,0.0 )}\nE_Q Q 0 VALUE {IF( (V(SET_PLS) > 0.5 & V(NR) > 0.5 ) , 1.0,0.0 )}\n.ENDS IR2112_LATCH_SIMPLE»
