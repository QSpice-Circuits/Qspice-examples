  «component (200,-1100) 0 0
    «symbol THD
      «type: X»
      «description: THD (Total Harmonic Distortion)»
      «library file: |.subckt THD v v1 THD\nB1 RMS-all 0 V=sqrt(idt((V(v)^2-if(time<tau,0,delay(V(v)^2,tau,2*tau))))/tau)\nB2 RMS-1 0 V=sqrt(idt((V(v1)^2-if(time<tau,0,delay(V(v1)^2,tau,2*tau))))/tau)\nB3 THD 0 V=if(time>tau, sqrt( V(RMS-all)**2 - V(RMS-1)**2) / V(RMS-1) , 0)\nE1 v1 0 v 0 Laplace=ButterworthBP(2,f0,BW)\n.param tau=1/f0\n.ends THD»
      «shorted pins: false»
      «rect (-300,300) (300,-300) 0 0 0 0x1000000 0xffe6c8 -1 0 -1»
