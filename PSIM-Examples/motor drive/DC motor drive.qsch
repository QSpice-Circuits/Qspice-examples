      «library file: |.subckt 1ph-Inverter dc+ dc- ac+ ac- s1 s4 s3 s2\nS1 dc+ ac+ s1 0 SWi OFF=OFF_HS ON=ON_HS\nS4 ac+ dc- s4 0 SWi OFF=OFF_LS ON=ON_LS\nD1 ac+ dc+ Di\nD4 dc- ac+ Di\nS3 dc+ ac- s3 0 SWi OFF=OFF_HS ON=ON_HS\nS2 ac- dc- s2 0 SWi OFF=OFF_LS ON=ON_LS\nD3 ac- dc+ Di\nD2 dc- ac- Di\n.model SWi SW Ron=Ron Roff=Roff Vt=0.5 Vh=0 TTOL=TTOL\n.model Di D Ron=Ron Roff=Roff Vfwd=Vfwd\n.param ON_HS =if(Initial==0,0,if(Initial==1,0,if(Initial==2,1,0)))\n.param OFF_HS=if(Initial==0,1,if(Initial==1,1,if(Initial==2,0,0)))\n.param ON_LS =if(Initial==0,0,if(Initial==1,1,if(Initial==2,0,0)))\n.param OFF_LS =if(Initial==0,1,if(Initial==1,0,if(Initial==2,1,0)))\n.ends 1ph-Inverter»
