  «component (2900,-2400) 0 0
    «symbol Variable-Frequency-PWM
      «type: X»
      «description: (PLECS) Variable Frequency PWM»
      «library file: |.subckt Variable-Frequency-PWM m df s\nV1 n1v 0 -1\nV2 p1v 0 1\n¥1 p1v n1v sign ¥ master 0 ¥ ¥ ¥ ¥ ¥ ¥ ¥ ¥ ¥ ¥ HMITT VT=VT VH=VH TTOL=TTOL\nB1 df-limit 0 V=limit(0.001,V(df),1000)\nB2 master 0 V=if(CarrierType==1,idt(V(f-setpoint),0,V(sign)), idt(sign*V(sign)*V(f-setpoint)*2,0,0))\nB3 latch 0 V=sign*V(sign)<=0.5 & state(1,sign*V(sign))>0.5\nB4 df-zoh 0 V=idt(0,V(df-limit),V(latch))\nB5 f-setpoint 0 V=V(df-zoh)*f\nB6 saw 0 V=V(master)*(CarrierLimits_max-CarrierLimits_min)+CarrierLimits_min\nB7 s 0 V=if(V(m)>V(saw),OutputValues_max,OutputValues_min)\n.param VT=if(CarrierType==1,1,0.5)\n.param VH=if(CarrierType==1,0,0.5)\n.param sign=if(CarrierType==1,1,-1)\n.ends Variable-Frequency-PWM»
      «shorted pins: false»
