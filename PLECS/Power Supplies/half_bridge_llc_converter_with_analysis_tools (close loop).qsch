  «text (6550,-1200) 1 7 0 0x1000000 -1 -1 "ï»¿// Electrical\n.param V_DC = 380;		     %[V]\n.param n_prim = 33;\n.param n_sndry = 2;\n\n// Primary Side\n.param L_r = 55e-6;			  %[H]\n.param L_m = 275e-6;		  %[H]\n.param C_r = 24e-9;			  %[F]\n\n// Secondary Side\n.param C_o = 1300e-6;		  %[F]\n.param C_v_init = 0;		  %[V]\n.param R_o = 12/5;			  %[Ohm]\n.param ESR = 15e-3;		     %[Ohm]\n\n.param V_out_desired = 12; %[V]\n\n// Controller\n.param R1 = 19.7e3;\n.param R2 = R1/3;\n.param V_ref = V_out_desired * R2 / (R1 + R2); % reference voltage\n\n// Type 2 Compensator\n.param wz1 = 2*pi*4.2e3; % frequency of type2 zero\n.param wp0 = 3.2e3; % DC gain of type 2 compensator\n.param wp1 = 2*pi*8.2e3; % frequency of type2 pole"»
  «text (2300,1150) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 0.01 skipbp\n.option maxstep=1/100e3/100\n.plot V(VOUT)\n.plot I(Rload)\n.plot V(df)"»
  «text (-1600,-4000) 1 7 1 0x1000000 -1 -1 "ï»¿add UIC or SkipBP in .tran for proper Laplace initial condition"»
