  «text (-400,2750) 1 7 0 0x1000000 -1 -1 "ï»¿// VSI characteristics\n.param Vdc = 600; %total Vdc bus sum of isolated series dc voltage sources\n.param ncells = 3; %number of cascaded series connected half bridge cells\n\n// Modulator\n.param fsw = 10000; %carrier wave switching frequency (Hz)\n.param fac = 50; %reference wave frequency (Hz)\n.param Tdt = 0.00*1/fsw; %deadtime (s)\n\n// Three-phase load\n.param Rg = 10; %grid resistance (ohms)\n.param Lg = 0.01; %grid inductance (Henries)"»
