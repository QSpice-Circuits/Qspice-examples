  «text (9850,-1250) 1 7 0 0x1000000 -1 -1 "ï»¿.param f = 250e3;              % switching frequency (Hz)\n.param Pinitial=1000;\n\n// Circuit parameters\n.param Vin = 95;               % input voltage (V)\n.param Vout = 380;             % output voltage (V)\n.param Ron1=30e-3;\n.param Ron2=65e-3\n.param Llk = 2.052e-6;         % leakage inductance (H)\n.param Co = 30e-6;             % output capacitance (F)\n.param Co_esr = 3.2e-3;			% output capacitance ESR (ohms)\n.param n_pri = 4;      % number of turns on the primary side\n.param n_sec = 16;     % number of turns on the secondary side\n.param Rload = Vout^2/Pinitial; % load resistance (ohms)\n\n// Digital PI controller\n.param Kp = 0.11173*0.015; 		% proportional gain\n.param Ki = 0.11173;       		% integral gain\n.param Kd = 0;             		% derivative gain\n.param N = 0;\n.param Ts = 50/f;         		% sample time (s)\n.param b0 = Kp*(1+N*Ts) + Ki*Ts*(1+N*Ts) + Kd*N;\n.param b1 = -(Kp*(2+N*Ts) + Ki*Ts + 2*Kd*N);\n.param b2 = Kp + Kd*N;\n.param a0 = 1+N*Ts;\n.param a1 = -(2+N*Ts);\n.param a2 = 1;"»
  «text (-1000,-1700) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 0.8\n.option listparams\n.save V(Vout) I(Iout) I(C1) V(pri+) V(pri-)\n.plot V(pri+,pri-)\n.plot I(C1)\n.plot I(Iout)\n.plot Vout*1V V(Vout)"»
  «text (-1100,-2800) 1 7 1 0x1000000 -1 -1 "ï»¿Phase Shift Controller"»
  «text (-1250,1750) 1 7 1 0x1000000 -1 -1 "ï»¿Dual Active Bridge"»
  «text (-1250,2450) 1 7 1 0x1000000 -1 -1 "ï»¿Functional equivalence as demo from PLECS, Power Supplies > Dual Active Bridge\n(dual_active_bridge_converter.plecs)\nby KSKelvin on 8-2-2026\nCustom Symbol download: https://github.com/KSKelvin-Github/Qspice"»
