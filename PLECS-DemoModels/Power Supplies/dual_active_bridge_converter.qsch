      «text (0,600) 1 15 0 0x1000000 -1 -1 "Variable-Phase-PWM"»
      «text (0,-600) 1 15 0 0x1000000 -1 -1 "CarrierType=<1;[Sawtooth],(2;[Symmetric])>Carrier Type"»
