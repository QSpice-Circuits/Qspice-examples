      «text (0,-600) 1 15 2 0x1000000 -1 -1 "thres=<0>Threshold"»
      «text (0,-750) 1 15 2 0x1000000 -1 -1 "Criteria=<(0),1,2>Criteria : 0-u~=0 | 1-u>=thres | 2-u>thres"»
      «text (0,-450) 1 79 1 0x1000000 -1 -1 "Criteria:u!=0"»
      «pin (0,200) (0,0) 1 15 0 0x0 -1 "u"»
      «pin (-200,100) (20,0) 1 15 0 0x0 -1 "Meet"»
      «pin (-200,-100) (0,0) 1 15 0 0x0 -1 "NotMeet"»
      «pin (200,0) (-20,0) 1 15 0 0x0 -1 "out"»
