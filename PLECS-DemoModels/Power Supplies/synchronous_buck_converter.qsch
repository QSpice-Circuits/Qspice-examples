  «text (7100,-6500) 1 7 0 0x1000000 -1 -1 "ï»¿// Plant parameters\n.param Vdc = 12;\n.param Vout= 5;\n.param Cout =15e-6;\n.param Rc= 7.5e-3;\n.param L= 30e-6;\n.param Rl= 50e-3;\n\n.param fsw= 250e3;\n.param td= 20e-9;\n\n// reference : synchronous_buck_converter.m\n// Gpid(s) = Kp+Ki/s+Kd*s/(s/Kf+1)\n.param Ki = 3.7646e+03\n.param Kf = 5.5179e+05;\n.param Kp = 0.3170;\n.param Kd = 4.7851e-06;"»
  «text (6550,-3100) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 1e-2\n.plot V(Vout)\n.plot I(L1)\n.plot V(Sw_Hi) V(Sw_Lo)+1.1"»
