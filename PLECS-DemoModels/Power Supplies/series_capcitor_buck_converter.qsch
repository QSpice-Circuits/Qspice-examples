  «text (7250,-4750) 1 7 0 0x1000000 -1 -1 "ï»¿// Converter parameters\n.param Vin=12;          %Input voltage in V\n.param Vout=1.2;        %Desired output voltage in V\n.param Rout=0.25;       %Load in ohms\n\n.param Cser=2.2e-6;     %Series capaitance in F\n.param R_Cser=0.001;    %Equivalent series resistance in ohms\n.param L=220e-9;        %Inductor voltage in H\n.param R_L=0.001;       %Equivalent series resistance in ohms\n.param Cout=200e-6;     %Output capacitance in F\n.param R_Cout=0.01;     %Equivalent series resistance in ohms\n\n// Feedback network\n.param Rfb=10e3;        %Resistance of the feedback network in ohms\n.param Cfb=22e-9;       %Capacitance of the feedback network in F\n.param Vfb=Vout/2;      %Voltage of the feedback network in V\n\n// Controller parameters\n.param fsw=2e6;         					%Switching frequency in HZ\n.param ton=(2*Vout)/(Vin*fsw);      	%Constant on-time duration\n.param toff_min=(0.5*Vout)/(Vin*fsw);	%Minimum off-time duration"»
  «text (5850,-7950) 1 7 1 0x1000000 -1 -1 "ï»¿Feedback\nnetwork"»
  «text (400,-11100) 1 7 1 0x1000000 -1 -1 "ï»¿COT Controller"»
  «text (7250,-7800) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 7e-3\n.plot V(Vout)\n.plot V(VSWA) V(VSWB)\n.plot V(CS+,CS-)\n.plot I(L1) I(L3) I(C1)"»
  «text (2550,-3200) 1 7 1 0x1000000 -1 -1 "ï»¿Series capacitor buck converter "»
  «text (-50,-2250) 1 7 1 0x1000000 -1 -1 "ï»¿Functional equivalence as demo from PLECS, Power Supplies > Series Capacitor Buck Converter\n(series_capcitor_buck_converter.plecs)\nby KSKelvin on 8-2-2026\nCustom Symbol download: https://github.com/KSKelvin-Github/Qspice"»
