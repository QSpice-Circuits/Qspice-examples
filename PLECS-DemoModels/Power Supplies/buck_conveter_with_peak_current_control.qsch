      «library file: |.subckt Continuous-PID-Controller e u reset\nB1 ep 0 V=Kp*V(e)\nB3 ei 0 V=if(aw_method==0,idt(Ki*V(e),x0,V(Reset)), if(aw_method==1,idt(Ki*V(e)+Kbc*V(u,ud),x0,V(Reset)), Ki * idt( if( (V(u) >= up_limit & V(e)>0 ) | (V(u) <= low_limit & V(e)<0), 0, V(e) ), x0, V(Reset) ) ) )\nB2 ed 0 V=Kf*(Kd*V(e)-idt(V(ed)))\nB4 ud 0 V=V(ep)+V(ed)+V(ei)\nB5 u 0 V=limit(V(ud),up_limit,low_limit)\n.ends Continuous-PID-Controller»
